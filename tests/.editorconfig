# Test-only analyzer conventions.

[*.cs]
# Tests may keep small fixtures and support types beside the behavior they exercise.
dotnet_diagnostic.TOUKI0020.severity = none

# Naming rule violation (TOUKI0041)
# Test methods follow Method_State_Expectation naming. Keep TOUKI0041 active for all
# other symbols while exempting only MSTest's attributed test entry points.
touki_naming_rule.mstest_behavior_names.severity = none
touki_naming_rule.mstest_behavior_names.symbols = mstest_methods, mstest_data_methods
touki_naming_rule.mstest_behavior_names.style = pascal_case_style

touki_naming_symbols.mstest_methods.applicable_kinds = method
touki_naming_symbols.mstest_methods.required_attributes = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

touki_naming_symbols.mstest_data_methods.applicable_kinds = method
touki_naming_symbols.mstest_data_methods.required_attributes = Microsoft.VisualStudio.TestTools.UnitTesting.DataTestMethodAttribute

touki_naming_style.pascal_case_style.capitalization = pascal_case
