<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Filtrace</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TraceEvent is the default trace-reading engine and is not AOT-compatible.
      FastTraceRepoRoot selects the provisional source integration; Native AOT
      validation is explicit and host-specific, not an unconditional property of
      the published heads. See docs/source-build.md for the tested build path and
      deployment limits.
    -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Condition="'$(FastTraceRepoRoot)' == ''" />
    <ProjectReference Include="$(FastTraceRepoRoot)/src/fasttrace/fasttrace.csproj" Condition="'$(FastTraceRepoRoot)' != ''" />
    <!--
      Touki's shared utilities. Referenced from the core so they flow transitively
      to the CLI head, the MCP facade, and the tests, which lets every Filtrace
      project consume Touki without each declaring the dependency.
    -->
    <PackageReference Include="KlutzyNinja.Touki" />
  </ItemGroup>

  <!--
    The analysis object model is public: the CLI head (Filtrace) and the MCP facade
    (Filtrace.Mcp) consume it through the public surface, not via InternalsVisibleTo.
    The test projects still see internals (the format readers behind TraceLoader,
    the LRU cache, and a few test-only members) for white-box testing. filtrace
    assemblies are not strong-named, so no PublicKey is required.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Filtrace.Core.Tests" />
    <InternalsVisibleTo Include="Filtrace.Parity.Tests" />
  </ItemGroup>

</Project>
