<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fixture-generation benchmark (see filtrace/fixtures/README.md). Deliberately
    excluded from filtrace.slnx so the subtree CI and the extraction rehearsal stay
    light: it is a manual regeneration tool run by make-fixtures.ps1, not part of
    the build/test loop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TraceQ.Fixtures.HotLoopBench</RootNamespace>
    <AssemblyName>HotLoopBench</AssemblyName>
    <!--
      Multi-targeted so the same benchmarks capture both halves of the corpus:
      net10.0 and net11.0 for EventPipe (.nettrace) profiles, and net481 for the ETW
      (.etl) profile the net481 gap needs. This manual tool overrides the
      product's target list and remains excluded from filtrace.slnx.
    -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0;net481</TargetFrameworks>
    <DefineConstants>$(DefineConstants);FILTRACE_HOT_LOOP_BENCH</DefineConstants>
    <!-- Release is mandatory for EventPipe profiling to reflect optimized code. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Filtrace.Core\GlobalDiagnosticsUsings.cs" Link="GlobalDiagnosticsUsings.cs" />
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Used by the `inspect` verb to confirm a capture carries the expected event types. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <!-- The [EtwProfiler] attribute for the net481 ETW capture (Windows-only). -->
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
