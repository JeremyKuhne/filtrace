{
  "id": "point-in-time-snapshot",
  "title": "Explain one narrow window with cross-lane snapshot evidence.",
  "prompt": "At 55 ms into this trace, what was happening within plus or minus 10 ms? In one analysis call, report the exact resolved window, the top CPU leaf method, the total exception count and most frequent exception type, and the total raw event count.",
  "fixture": "tests/Filtrace.Core.Tests/Fixtures/exceptions.nettrace",
  "os": "any",
  "steps": [
    { "args": ["timeline", "{fixture}", "--mode", "snapshot", "--at", "55", "--window", "10"] }
  ],
  "assert": [
    { "field": "result.mode", "equals": "snapshot" },
    { "field": "result.fromMs", "equals": 45 },
    { "field": "result.toMs", "equals": 65 },
    { "field": "result.snapshot.cpu.methods[0].name", "equals": "System.String.StrCns" },
    { "field": "result.snapshot.exceptions.exceptionCount", "equals": 1813 },
    { "field": "result.snapshot.exceptions.types[0].name", "equals": "System.InvalidOperationException" },
    { "field": "result.snapshot.events.eventCount", "equals": 7387 }
  ],
  "expect": ["45", "65", "System.String.StrCns", "1813", "InvalidOperationException", "7387"]
}