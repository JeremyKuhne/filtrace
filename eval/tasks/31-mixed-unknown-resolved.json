{
  "id": "mixed-unknown-resolved",
  "title": "Separate unknown and named speedscope CPU self rows without hiding their denominator.",
  "prompt": "In this synthetic speedscope CPU profile, which frame is hottest by self weight, and are there any named candidates? Explain how much profiled self weight remains unknown, what you would check or drill next, and one claim this profile does not support.",
  "fixture": "tests/Filtrace.Core.Tests/Fixtures/mixed-unknown.speedscope.json",
  "os": "any",
  "steps": [
    { "args": ["rank", "{fixture}", "--metric", "cpu", "--children", "include", "--top", "3"] },
    { "args": ["info", "{fixture}", "--children", "include"] },
    { "args": ["callers", "{fixture}", "App.Work", "--children", "include"], "optional": true }
  ],
  "assert": [
    { "step": 0, "field": "context.unit", "equals": "ms" },
    { "step": 0, "field": "result.scopeWeight", "equals": 100 },
    { "step": 0, "field": "result.rows[0].frame", "equals": "?" },
    { "step": 0, "field": "result.rows[0].weight", "equals": 60 },
    { "step": 0, "field": "result.rows[0].percentOfScope", "equals": 60 },
    { "step": 0, "field": "result.rows[1].frame", "equals": "App.Work" },
    { "step": 0, "field": "result.rows[1].weight", "equals": 25 },
    { "step": 0, "field": "result.rows[1].percentOfScope", "equals": 25 },
    { "step": 0, "field": "result.rows[2].frame", "equals": "App.Other" },
    { "step": 0, "field": "result.rows[2].weight", "equals": 15 },
    { "step": 0, "field": "result.rows[2].percentOfScope", "equals": 15 },
    { "step": 0, "field": "result.contributingRecordCount", "equals": 3 },
    { "step": 0, "field": "hints[0].operation", "equals": "info" },
    { "step": 0, "field": "hints[0].arguments.path", "endsWith": "mixed-unknown.speedscope.json" },
    { "step": 0, "field": "hints[0].arguments.includeChildren", "equals": true },
    { "step": 0, "field": "hints[1].operation", "equals": "callers" },
    { "step": 0, "field": "hints[1].arguments.frame", "equals": "App.Work" },
    { "step": 0, "field": "hints[1].arguments.metric", "equals": "cpu" },
    { "step": 0, "hintContains": "info <trace>" },
    { "step": 0, "hintContains": "callers 'App.Work'" },
    { "step": 1, "field": "context.operation", "equals": "info" },
    { "step": 1, "field": "result.path", "endsWith": "mixed-unknown.speedscope.json" },
    { "step": 1, "field": "result.format", "equals": "Speedscope" },
    { "step": 1, "field": "result.sampleCount", "equals": 3 },
    { "step": 1, "field": "result.symbolResolutionRate", "equals": 1 },
    { "step": 1, "field": "result.cpuSampling.weightUnit", "equals": "ms" },
    { "step": 1, "field": "result.cpuSampling.source", "equals": "speedscope-profile-declared-time-weights" },
    { "step": 2, "field": "context.operation", "equals": "callers" },
    { "step": 2, "field": "result.focus", "equals": "App.Work" },
    { "step": 2, "field": "result.targetWeight", "equals": 25 },
    { "step": 2, "field": "result.percentOfScope", "equals": 25 },
    { "step": 2, "field": "result.scopeWeight", "equals": 100 },
    { "step": 2, "field": "result.callers[0].caller", "equals": "App.Main" },
    { "step": 2, "field": "result.callers[0].weight", "equals": 25 },
    { "step": 2, "field": "result.callers[0].percentOfTarget", "equals": 100 },
    { "step": 2, "field": "result.contributingRecordCount", "equals": 1 }
  ],
  "expect": ["Speedscope", "?", "60%", "App.Work", "25%", "100", "info"]
}
