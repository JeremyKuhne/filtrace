# filtrace incubation subtree - self-contained style root.
# root = true stops editor and analyzer config from inheriting Touki's .editorconfig,
# so the subtree's style travels intact when it is promoted to a standalone repo.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# Touki's house-style analyzers ship disabled so consuming repositories opt in
# deliberately. Filtrace enables the complete analyzer set.
# Derive disposable classes from DisposableBase (TOUKI0012)
dotnet_diagnostic.TOUKI0012.severity = warning

# Avoid tab characters (TOUKI0022)
dotnet_diagnostic.TOUKI0022.severity = warning

# Format XML documentation as nested XML (TOUKI0024)
dotnet_diagnostic.TOUKI0024.severity = warning

# Use configured Allman formatting (TOUKI0027)
dotnet_diagnostic.TOUKI0027.severity = warning

# Format statement breaks around operators (TOUKI0028)
dotnet_diagnostic.TOUKI0028.severity = warning

# Name literal arguments (TOUKI0029)
dotnet_diagnostic.TOUKI0029.severity = warning

# Naming rule violation (TOUKI0041)
dotnet_diagnostic.TOUKI0041.severity = warning
