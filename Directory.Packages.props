<?xml version="1.0" encoding="utf-8"?>
<!--
  filtrace's own central package versions. Deliberately NOT inherited from Touki's
  Directory.Packages.props - the nearest file wins, keeping the dependency set
  self-contained so promotion to a standalone repo needs no edits here.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Trace parsing and analysis core. -->
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />

    <!--
      Touki's shared utilities (ValueStringBuilder, StringSegment, the allocation-
      aware collections, ...). Consumed as the published NuGet package, not a project
      reference, so the subtree stays self-contained and promotion remains a plain
      file copy: a standalone filtrace repo references the same package unchanged.
    -->
    <PackageVersion Include="KlutzyNinja.Touki" Version="0.10.0" />
    <PackageVersion Include="KlutzyNinja.Touki.Analyzers" Version="0.11.1" />

    <!-- The preview supports .NET 11; use a stable release when one supports it. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- The ETW (.etl) profiler for the net481 fixture half; Windows-only, capture needs elevation. -->
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.16.0-preview.2" />

    <!-- MCP facade host. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />

    <!-- CLI head: source-generated, zero-runtime-dependency command parser. -->
    <PackageVersion Include="ConsoleAppFramework" Version="5.8.1" />

    <!-- Test stack: Microsoft.Testing.Platform + MSTest, matching Touki's migrated runner. -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />

    <!-- Versioning: stamps the package and assembly versions from git tags at pack time. -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

</Project>
